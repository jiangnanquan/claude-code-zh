# claude-hud 进度条 ASCII 化补丁
#
# 把 statusline 进度条的 Unicode 块字符（█ ░）换成纯 ASCII 的 [ ] = - ，
# 避免部分字体/终端下块字符宽度判定不一致导致的状态栏错位。
#
#   改前:  Context █████░░░░░ 45%
#   改后:  Context [=====-----] 45%
#
# 目标: ~/.claude/plugins/cache/claude-hud/claude-hud/<version>/
#        （statusline 直接运行该目录的 src/index.ts，改 src 即生效）
#
# 应用:
#   cd ~/.claude/plugins/cache/claude-hud/claude-hud/<version>
#   patch -p1 -N < ~/Dev/Private/claude-code-zh/patches/claude-hud-ascii-bar.patch
#
# 说明:
#   - 含 src/render/colors.ts（生效）+ 测试断言 + 快照；dist/ 由 npm run build 生成
#   - 插件升级会切到新版本目录，需在新目录重新应用（-N 让重复应用直接跳过）
#   - 上游若改动行号/上下文导致 patch 失败，按下面两处手改即可：
#       src/render/colors.ts 中的 quotaBar() 与 coloredBar() 末尾 return 行
#       把  ${color}${'█'.repeat(filled)}${DIM}${'░'.repeat(empty)}${RESET}
#       换成 ${DIM}[${RESET}${color}${'='.repeat(filled)}${DIM}${'-'.repeat(empty)}]${RESET}
#   - 基准版本: claude-hud 0.0.10
--- a/src/render/colors.ts
+++ b/src/render/colors.ts
@@ -105,7 +105,7 @@
   const filled = Math.round((safePercent / 100) * safeWidth);
   const empty = safeWidth - filled;
   const color = getQuotaColor(safePercent, colors);
-  return `${color}${'█'.repeat(filled)}${DIM}${'░'.repeat(empty)}${RESET}`;
+  return `${DIM}[${RESET}${color}${'='.repeat(filled)}${DIM}${'-'.repeat(empty)}]${RESET}`;
 }
 
 export function coloredBar(percent: number, width: number = 10, colors?: Partial<HudColorOverrides>): string {
@@ -114,5 +114,5 @@
   const filled = Math.round((safePercent / 100) * safeWidth);
   const empty = safeWidth - filled;
   const color = getContextColor(safePercent, colors);
-  return `${color}${'█'.repeat(filled)}${DIM}${'░'.repeat(empty)}${RESET}`;
+  return `${DIM}[${RESET}${color}${'='.repeat(filled)}${DIM}${'-'.repeat(empty)}]${RESET}`;
 }
--- a/tests/render.test.js
+++ b/tests/render.test.js
@@ -1036,9 +1036,9 @@
 
   const line = renderUsageLine(ctx);
   assert.ok(line, 'should render usage line');
-  assert.ok(line.includes('\x1b[36m███'), `expected custom usage bar color, got: ${JSON.stringify(line)}`);
+  assert.ok(line.includes('\x1b[36m==='), `expected custom usage bar color, got: ${JSON.stringify(line)}`);
   assert.ok(line.includes('\x1b[36m25%\x1b[0m'), `expected custom usage percentage color, got: ${JSON.stringify(line)}`);
-  assert.ok(line.includes('\x1b[35m████████'), `expected custom usage warning color, got: ${JSON.stringify(line)}`);
+  assert.ok(line.includes('\x1b[35m========'), `expected custom usage warning color, got: ${JSON.stringify(line)}`);
   assert.ok(line.includes('\x1b[35m80%\x1b[0m'), `expected custom usage warning percentage color, got: ${JSON.stringify(line)}`);
 });
 
